{
  "manifest_version": 3,
  "name": "Subtitle Reader",
  "version": "1.0.0",
  "description": "YouTube videolarindaki altyazilari tarayicinin TTS motoru ile seslendirir.",
  "permissions": ["storage"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Subtitle Reader"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
