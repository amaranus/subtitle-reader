{
  "manifest_version": 3,
  "name": "Subtitle Reader",
  "version": "1.1.0",
  "description": "YouTube videolarindaki altyazilari tarayici TTS veya yerel Supertonic sunucusu ile seslendirir.",
  "permissions": ["storage", "offscreen"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Subtitle Reader"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
